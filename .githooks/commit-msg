#!/bin/sh
# Installed by setup (git config core.hooksPath .githooks). Never bypass with --no-verify.
# State-file check: warns (comment mode) or refuses (block mode, see .state-check-mode) when code
# changes without STATE.md / DECISIONS.md / AGENTS.md. Skip one commit with [no-state] in its message.
ROOT=$(git rev-parse --show-toplevel)
grep -q '\[no-state\]' "$1" 2>/dev/null && exit 0
bash "$ROOT/scripts/state-check.sh" HEAD --staged "$1"
