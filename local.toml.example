# Copy to local.toml (ignored by git) and edit. setup.sh/setup.ps1 create it if missing.
# Every value can also come from the environment variable named in the comment.

[paths]
models_dir = ""        # MODELS_DIR; empty = <Desktop>/models (OneDrive Desktop if OneDrive keeps one). Windows paths: use single quotes
cad_staging = ""       # CAD_STAGING; scratch output for renders/reports (outside the repo)
freecad_dir = ""       # FREECAD_DIR; folder that holds bin/freecadcmd(.exe)
fairsolid_runs = ""    # FAIRSOLID_RUNS; where pipeline run folders go (outside the repo)
scratch_dir = ""       # SCRATCH_DIR; disposable clones and handoff packs for toolkit patches (outside every live checkout)

[python]
cad_py = ""            # CAD_PY; empty = <repo>/.venv/bin/python
